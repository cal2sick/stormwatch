# Copy to .env (never commit .env):  cp .env.example .env
# Everything here stays on your computer. .env is git-ignored.

# Contact string sent as User-Agent to api.weather.gov and other NOAA/USGS feeds (NWS asks for one).
# Put your own app name and a contact address you are happy to share with NOAA, or leave the default.
USER_AGENT="Stormwatch/0.1 (self-hosted; contact: you@example.com)"

# Your location in decimal degrees (get them from any map app: right-click / long-press a spot).
# No default: if unset, the map shows storms only and asks you to set a location.
# HOME_LAT=
# HOME_LON=
# HOME_NAME="Home"

# Optional: port (default 8787) and bind host (default localhost; keep it that way unless you know why)
# PORT=8787
# HOST=localhost

# Optional: river gauge search box around your location, in degrees each way (default 0.6)
# USGS_BOX_DEG=0.6

# ---- Optional plugins (all OFF unless set). See docs/DATA-SOURCES.md ----
# Live outage points from your utility's PUBLIC ArcGIS outage layer (query URL with f=json&outSR=4326).
# OUTAGE_ARCGIS_URL=
# OUTAGE_ARCGIS_NAME="My utility outages"
# OUTAGE_MAP_URL=
# County-level outage reports from ORNL ODIN, by 5-digit county FIPS code.
# ODIN_FIPS=

# Optional: Windy Webcams (adds more live cameras). Get your OWN free key at https://api.windy.com/webcams
# Keep it here in .env only. Never commit it. Leave empty to use only the keyless USGS cameras.
# WINDY_API_KEY=
